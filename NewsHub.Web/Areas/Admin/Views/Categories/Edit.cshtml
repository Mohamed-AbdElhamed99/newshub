@model NewsHub.Web.Areas.Admin.ViewModels.Categories.CategoryFormViewModel
@{
    ViewData["Title"] = "Edit Category";
}

<div class="card mb-4">
    <div class="card-header"><h5 class="mb-0">@Localizer["Edit"] @Localizer["Category"]</h5></div>
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <partial name="_Form" model="Model" />
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}