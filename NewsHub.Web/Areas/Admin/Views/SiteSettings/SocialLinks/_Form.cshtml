@model NewsHub.Web.Areas.Admin.ViewModels.SocialLinks.SocialLinkFormViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger d-none" id="validationSummary"></div>
@if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
}

<input type="hidden" asp-for="Id" />

<div class="row mb-3">
    <label class="col-sm-2 col-form-label" asp-for="Platform"></label>
    <div class="col-sm-10">
        <input asp-for="Platform" class="form-control" placeholder="e.g. Facebook" />
        <span asp-validation-for="Platform" class="text-danger"></span>
    </div>
</div>
<div class="row mb-3">
    <label class="col-sm-2 col-form-label" asp-for="Url"></label>
    <div class="col-sm-10">
        <input asp-for="Url" class="form-control" placeholder="https://facebook.com/yourpage" />
        <span asp-validation-for="Url" class="text-danger"></span>
    </div>
</div>
<div class="row mb-3">
    <label class="col-sm-2 col-form-label" asp-for="IconClass"></label>
    <div class="col-sm-10">
        <input asp-for="IconClass" class="form-control" placeholder="bxl-facebook-circle" />
        <span asp-validation-for="IconClass" class="text-danger"></span>
        <div class="form-text">Boxicon class name, without the leading "bx".</div>
    </div>
</div>
<div class="row mb-3">
    <label class="col-sm-2 col-form-label" asp-for="DisplayOrder"></label>
    <div class="col-sm-10">
        <input asp-for="DisplayOrder" type="number" class="form-control" />
        <span asp-validation-for="DisplayOrder" class="text-danger"></span>
    </div>
</div>
<div class="row mb-3">
    <div class="col-sm-10 offset-sm-2">
        <div class="form-check">
            <input asp-for="IsActive" class="form-check-input" />
            <label class="form-check-label" asp-for="IsActive"></label>
        </div>
    </div>
</div>

<div class="row justify-content-end">
    <div class="col-sm-10">
        <button type="submit" class="btn btn-primary">@Localizer["Save"]</button>
        <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Cancel"]</a>
    </div>
</div>