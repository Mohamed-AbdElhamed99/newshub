@model NewsHub.Web.Areas.Admin.ViewModels.Tags.TagFormViewModel

@if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
}

<input type="hidden" asp-for="Id" />
<input type="hidden" asp-for="English.LanguageCode" />
<input type="hidden" asp-for="Arabic.LanguageCode" />

<ul class="nav nav-tabs mb-3" role="tablist">
    <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-en" type="button">English</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-ar" type="button">Arabic</button></li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="tab-en">
        <div class="row mb-3">
            <label class="col-sm-2 col-form-label" asp-for="English.Name">@Localizer["Name"]</label>
            <div class="col-sm-10">
                <input asp-for="English.Name" class="form-control" />
                <span asp-validation-for="English.Name" class="text-danger"></span>
            </div>
        </div>
        <div class="row mb-3">
            <label class="col-sm-2 col-form-label" asp-for="English.Slug">@Localizer["Slug"]</label>
            <div class="col-sm-10">
                <input asp-for="English.Slug" class="form-control" />
                <span asp-validation-for="English.Slug" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="tab-pane fade" id="tab-ar" dir="rtl">
        <div class="row mb-3">
            <label class="col-sm-2 col-form-label" asp-for="Arabic.Name">@Localizer["Name"]</label>
            <div class="col-sm-10">
                <input asp-for="Arabic.Name" class="form-control" />
                <span asp-validation-for="Arabic.Name" class="text-danger"></span>
            </div>
        </div>
        <div class="row mb-3">
            <label class="col-sm-2 col-form-label" asp-for="Arabic.Slug">@Localizer["Slug"]</label>
            <div class="col-sm-10">
                <input asp-for="Arabic.Slug" class="form-control" dir="ltr" />
                <span asp-validation-for="Arabic.Slug" class="text-danger"></span>
            </div>
        </div>
    </div>
</div>

<div class="row justify-content-end">
    <div class="col-sm-10">
        <button type="submit" class="btn btn-primary">@Localizer["Save"]</button>
        <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Cancel"]</a>
    </div>
</div>