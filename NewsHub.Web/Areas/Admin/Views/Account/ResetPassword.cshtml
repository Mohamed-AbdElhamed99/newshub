@model NewsHub.Web.Areas.Admin.ViewModels.ResetPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Reset Password";
}

<div class="card">
    <div class="card-body">
        <div class="app-brand justify-content-center">
            <a asp-area="Admin" asp-controller="Account" asp-action="Login" class="app-brand-link gap-2">
                <span class="app-brand-logo demo"><i class="bx bx-news bx-lg text-primary"></i></span>
                <span class="app-brand-text demo text-body fw-bolder">NewsHub</span>
            </a>
        </div>

        <h4 class="mb-2">Reset Password 🔑</h4>
        <p class="mb-4">Enter a new password for your account</p>

        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert" style="@(ViewData.ModelState.ErrorCount > 0 ? "" : "display:none;")"></div>

        <form asp-area="Admin" asp-controller="Account" asp-action="ResetPassword" method="post" class="mb-3">
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="Token" />

            <div class="mb-3 form-password-toggle">
                <label asp-for="NewPassword" class="form-label"></label>
                <div class="input-group input-group-merge">
                    <input asp-for="NewPassword" class="form-control" placeholder="&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;" />
                    <span class="input-group-text cursor-pointer"><i class="bx bx-hide"></i></span>
                </div>
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>

            <div class="mb-3 form-password-toggle">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <div class="input-group input-group-merge">
                    <input asp-for="ConfirmPassword" class="form-control" placeholder="&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;" />
                    <span class="input-group-text cursor-pointer"><i class="bx bx-hide"></i></span>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button class="btn btn-primary d-grid w-100" type="submit">Set New Password</button>
        </form>

        <div class="text-center">
            <a asp-area="Admin" asp-controller="Account" asp-action="Login" class="d-flex align-items-center justify-content-center">
                <i class="bx bx-chevron-left scaleX-n1-rtl bx-sm"></i>
                Back to login
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
