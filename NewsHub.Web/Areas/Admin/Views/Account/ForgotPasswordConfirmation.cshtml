@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Check Your Email";
}

<div class="card">
    <div class="card-body text-center">
        <div class="app-brand justify-content-center">
            <span class="app-brand-logo demo"><i class="bx bx-envelope bx-lg text-primary"></i></span>
        </div>

        <h4 class="mb-2">Check your email 📬</h4>
        <p class="mb-4">
            If an account exists with that email, we've sent instructions to reset your password.
        </p>

        <a asp-area="Admin" asp-controller="Account" asp-action="Login" class="btn btn-primary d-grid w-100">
            Back to login
        </a>
    </div>
</div>