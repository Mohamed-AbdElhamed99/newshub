@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Password Reset";
}

<div class="card">
    <div class="card-body text-center">
        <div class="app-brand justify-content-center">
            <span class="app-brand-logo demo"><i class="bx bx-check-circle bx-lg text-success"></i></span>
        </div>

        <h4 class="mb-2">Password reset ✅</h4>
        <p class="mb-4">Your password has been reset successfully. You can now sign in.</p>

        <a asp-area="Admin" asp-controller="Account" asp-action="Login" class="btn btn-primary d-grid w-100">
            Back to login
        </a>
    </div>
</div>