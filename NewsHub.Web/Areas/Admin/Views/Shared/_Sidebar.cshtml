@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;

    bool IsActive(string controller) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);
}

<aside id="layout-menu" class="layout-menu menu-vertical menu bg-menu-theme">
    <div class="app-brand demo">
        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="app-brand-link">
            <span class="app-brand-logo demo">
                <i class="bx bx-news bx-sm text-primary"></i>
            </span>
            <span class="app-brand-text demo menu-text fw-bolder ms-2">NewsHub</span>
        </a>
        <a href="javascript:void(0);" class="layout-menu-toggle menu-link text-large ms-auto d-block d-xl-none">
            <i class="bx bx-chevron-left bx-sm align-middle"></i>
        </a>
    </div>

    <div class="menu-inner-shadow"></div>

    <ul class="menu-inner py-1">
        <li class="menu-item @(IsActive("Dashboard") ? "active" : "")">
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="menu-link">
                <i class="menu-icon tf-icons bx bx-home-circle"></i>
                <div>Dashboard</div>
            </a>
        </li>

        <li class="menu-header small text-uppercase"><span class="menu-header-text">Content</span></li>

        <li class="menu-item @(IsActive("Articles") ? "active" : "")">
            <a asp-area="Admin" asp-controller="Articles" asp-action="Index" class="menu-link">
                <i class="menu-icon tf-icons bx bx-news"></i>
                <div>Articles</div>
            </a>
        </li>
        <li class="menu-item @(IsActive("Categories") ? "active" : "")">
            <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="menu-link">
                <i class="menu-icon tf-icons bx bx-category"></i>
                <div>Categories</div>
            </a>
        </li>
        <li class="menu-item @(IsActive("Tags") ? "active" : "")">
            <a asp-area="Admin" asp-controller="Tags" asp-action="Index" class="menu-link">
                <i class="menu-icon tf-icons bx bx-purchase-tag-alt"></i>
                <div>Tags</div>
            </a>
        </li>

        <li class="menu-header small text-uppercase"><span class="menu-header-text">Engagement</span></li>

        <li class="menu-item @(IsActive("Comments") ? "active" : "")">
            <a asp-area="Admin" asp-controller="Comments" asp-action="Index" class="menu-link">
                <i class="menu-icon tf-icons bx bx-comment-detail"></i>
                <div>Comments</div>
            </a>
        </li>
        <li class="menu-item @(IsActive("ArticleRatings") ? "active" : "")">
            <a asp-area="Admin" asp-controller="ArticleRatings" asp-action="Index" class="menu-link">
                <i class="menu-icon tf-icons bx bx-star"></i>
                <div>Ratings</div>
            </a>
        </li>
        <li class="menu-item @(IsActive("Subscriptions") ? "active" : "")">
            <a asp-area="Admin" asp-controller="Subscriptions" asp-action="Index" class="menu-link">
                <i class="menu-icon tf-icons bx bx-envelope"></i>
                <div>Subscriptions</div>
            </a>
        </li>
        <li class="menu-item @(IsActive("ContactMessages") ? "active" : "")">
            <a asp-area="Admin" asp-controller="ContactMessages" asp-action="Index" class="menu-link">
                <i class="menu-icon tf-icons bx bx-envelope-open"></i>
                <div>Contact Messages</div>
            </a>
        </li>

        <li class="menu-header small text-uppercase"><span class="menu-header-text">Settings</span></li>

        <li class="menu-item @(IsActive("SiteSettings") ? "active" : "")">
            <a asp-area="Admin" asp-controller="SiteSettings" asp-action="Index" class="menu-link">
                <i class="menu-icon tf-icons bx bx-cog"></i>
                <div>Site Settings</div>
            </a>
        </li>
    </ul>
</aside>
