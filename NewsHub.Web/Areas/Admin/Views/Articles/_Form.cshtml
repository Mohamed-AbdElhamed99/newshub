@model NewsHub.Web.Areas.Admin.ViewModels.Articles.ArticleFormViewModel

@if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
}

<input type="hidden" asp-for="Id" />
<input type="hidden" asp-for="English.LanguageCode" />
<input type="hidden" asp-for="Arabic.LanguageCode" />

<div class="row mb-3">
    <label class="col-sm-2 col-form-label" asp-for="CategoryId"></label>
    <div class="col-sm-10">
        <select asp-for="CategoryId" asp-items="Model.CategoryOptions" class="form-select">
            <option value="">-- @Localizer["Select"] @Localizer["Category"] --</option>
        </select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>
</div>

<div class="row mb-3">
    <label class="col-sm-2 col-form-label" asp-for="SelectedTagIds">@Localizer["Tags"]</label>
    <div class="col-sm-10">
        <select asp-for="SelectedTagIds" asp-items="Model.TagOptions" class="form-select" multiple size="5"></select>
        <div class="form-text">Hold Ctrl/Cmd to select multiple tags.</div>
        <span asp-validation-for="SelectedTagIds" class="text-danger"></span>
    </div>
</div>

<div class="row mb-3">
    <label class="col-sm-2 col-form-label" asp-for="Status">@Localizer["Status"]</label>
    <div class="col-sm-4">
        <select asp-for="Status" asp-items="Html.GetEnumSelectList<NewsHub.Domain.Enums.ArticleStatus>()" class="form-select"></select>
    </div>
    <div class="col-sm-6 d-flex align-items-center">
        <div class="form-check">
            <input asp-for="IsTrending" class="form-check-input" />
            <label class="form-check-label" asp-for="IsTrending">@Localizer["IsTrending"]</label>
        </div>
    </div>
</div>

<div class="row mb-3">
    <label class="col-sm-2 col-form-label">@Localizer["Image"]</label>
    <div class="col-sm-10">
        @if (!string.IsNullOrEmpty(Model.ExistingImageUrl))
        {
            <img src="@Model.ExistingImageUrl" width="100" height="60" class="rounded mb-2 d-block" alt="Current image" />
            <input asp-for="ExistingImageUrl" type="hidden" value="@Model.ExistingImageUrl" />
        }
        <input asp-for="ImageFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
        <span asp-validation-for="ImageFile" class="text-danger"></span>
        <div class="form-text">JPG, PNG or WEBP — max 5MB.</div>
    </div>
</div>

<ul class="nav nav-tabs mb-3" role="tablist">
    <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-en" type="button">English</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-ar" type="button">Arabic</button></li>
</ul>

<div class="tab-content mb-3">
    <div class="tab-pane fade show active" id="tab-en">
        @await Html.PartialAsync("_TranslationFields", Model.English, new ViewDataDictionary(ViewData) { { "Prefix", "English" } })
    </div>
    <div class="tab-pane fade" id="tab-ar" dir="rtl">
        @await Html.PartialAsync("_TranslationFields", Model.Arabic, new ViewDataDictionary(ViewData) { { "Prefix", "Arabic" } })
    </div>
</div>

<div class="row justify-content-end">
    <div class="col-sm-10">
        <button type="submit" class="btn btn-primary">@Localizer["Save"]</button>
        <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Cancel"]</a>
    </div>
</div>