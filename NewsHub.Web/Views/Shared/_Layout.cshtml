@{
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isRtl = currentCulture == "ar";
}
<!DOCTYPE html>
<html lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8">
    <title>@ViewData["Title"] - NewsHub</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&family=Raleway:wght@100;600;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <link href="~/site/lib/animate/animate.min.css" rel="stylesheet">
    <link href="~/site/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">
    <link href="~/site/css/bootstrap.min.css" rel="stylesheet">
    
    @if (isRtl)
    {
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    }
    
    <link href="~/site/css/style.css" rel="stylesheet">
    
    @if (isRtl)
    {
        <link href="~/site/css/rtl.css" rel="stylesheet">
    }

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <div id="spinner" class="show w-100 vh-100 bg-white position-fixed translate-middle top-50 start-50 d-flex align-items-center justify-content-center">
        <div class="spinner-grow text-primary" role="status"></div>
    </div>

    <!-- Navbar start -->
    <div class="container-fluid sticky-top px-0">
        <div class="container-fluid topbar bg-dark d-none d-lg-block">
            <div class="container px-0">
                <div class="topbar-top d-flex justify-content-between">
                    @await Component.InvokeAsync("TrendingTicker")
                    <div class="top-link flex-lg-wrap">
                        <i class="fas fa-calendar-alt text-white border-end border-secondary pe-2 me-2">
                            <span class="text-body">@DateTime.UtcNow.ToString("dddd, MMM d, yyyy")</span>
                        </i>
                    </div>
                    <div class="d-flex align-items-center flex-shrink-0">
                        <partial name="Components/_LanguageSwitcher" />
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="dropdown">
                                <a href="#" class="d-flex align-items-center text-white text-decoration-none dropdown-toggle"
                                   id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-user-circle me-2"></i>
                                    <span>@User.Identity.Name</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenu">
                                    <li>
                                        <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item">
                                                <i class="fas fa-sign-out-alt me-2"></i>@Localizer["Log Out"]
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Auth" asp-action="Login" class="text-white text-decoration-none me-3">
                                <i class="fas fa-sign-in-alt me-1"></i>@Localizer["Sign in"]
                            </a>
                            <a asp-controller="Auth" asp-action="Register" class="text-white text-decoration-none">
                                <i class="fas fa-user-plus me-1"></i>@Localizer["Register"]
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="container-fluid bg-light">
            <div class="container px-0">
                <nav class="navbar navbar-light navbar-expand-xl">
                    <a asp-controller="Home" asp-action="Index" class="navbar-brand mt-3">
                        <p class="text-primary display-6 mb-2" style="line-height:0;">@Localizer["NewsHub"]</p>
                    </a>
                    <button class="navbar-toggler py-2 px-3" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
                        <span class="fa fa-bars text-primary"></span>
                    </button>
                    <div class="collapse navbar-collapse bg-light py-3" id="navbarCollapse">
                        <div class="navbar-nav mx-auto border-top">
                            <a asp-controller="Home" asp-action="Index" class="nav-item nav-link">@Localizer["Home"]</a>
                            @await Component.InvokeAsync("CategoryNav")
                            <a asp-controller="Contact" asp-action="Index" class="nav-item nav-link">@Localizer["Contact Us"]</a>
                        </div>
                        <div class="d-flex flex-nowrap border-top pt-3 pt-xl-0" id="weatherWidget" style="display:none;">
                            <img id="weatherIcon" src="" class="img-fluid w-100 me-2" alt="" style="max-width:50px;">
                            <div class="d-flex align-items-center">
                                <strong class="fs-4 text-secondary" id="weatherTemp">--°C</strong>
                                <div class="d-flex flex-column ms-2" style="width: 150px;">
                                    <span class="text-body" id="weatherCondition">--</span>
                                    <small id="weatherDate"></small>
                                </div>
                            </div>
                        </div>
                    </div>
                </nav>
            </div>
        </div>
    </div>
    <!-- Navbar End -->

    <partial name="_SearchModal" />

    <div class="site-main">
        @RenderBody()
    </div>

    @await Component.InvokeAsync("SiteFooter")

    <a href="#" class="btn btn-primary border-2 border-white rounded-circle back-to-top"><i class="fa fa-arrow-up"></i></a>

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/site/lib/easing/easing.min.js"></script>
    <script src="~/site/lib/waypoints/waypoints.min.js"></script>
    <script src="~/site/lib/owlcarousel/owl.carousel.min.js"></script>
    <script src="~/site/js/main.js"></script>
    <script src="~/site/js/weather.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>