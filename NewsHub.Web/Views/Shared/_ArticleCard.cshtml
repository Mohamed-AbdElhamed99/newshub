@using NewsHub.Application.Site.DTOs.Articles
@using NewsHub.Web.Resources
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> Localizer
@model LatestArticleDto

<div class="latest-news-item">
    <div class="bg-light rounded">
        <div class="rounded-top overflow-hidden">
            <img src="@Model.ImageUrl" class="img-zoomin img-fluid rounded-top w-100" alt="@Model.Title">
        </div>
        <div class="d-flex flex-column p-4">
            <a asp-controller="Article" asp-action="Details" asp-route-slug="@Model.Slug" class="h4">@Model.Title</a>
            <div class="d-flex justify-content-between">
                <small class="text-body"><i class="fa fa-eye me-1"></i> @Model.ViewCount.ToString("N0") @Localizer["Views"]</small>
                <small class="text-body d-block">
                    <i class="fas fa-calendar-alt me-1"></i> @Model.PublishedAt.ToString("MMM d, yyyy")
                </small>
            </div>
        </div>
    </div>
</div>