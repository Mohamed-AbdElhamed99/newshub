@using NewsHub.Web.Models.Shared
@using NewsHub.Web.Resources
@model PaginationViewModel

@if (Model.TotalPages > 1)
{
    <nav aria-label="Page navigation" class="mt-5">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                <a class="page-link" asp-controller="@Model.Controller" asp-action="@Model.Action"
                   asp-all-route-data="@MergeRouteValues(Model.RouteValues, Model.CurrentPage - 1)">@Localizer["Previous"]</a>
            </li>

            @for (var i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-controller="@Model.Controller" asp-action="@Model.Action"
                       asp-all-route-data="@MergeRouteValues(Model.RouteValues, i)">@i</a>
                </li>
            }

            <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-controller="@Model.Controller" asp-action="@Model.Action"
                   asp-all-route-data="@MergeRouteValues(Model.RouteValues, Model.CurrentPage + 1)">@Localizer["Next"]</a>
            </li>
        </ul>
    </nav>
}

@functions {
    private Dictionary<string, string> MergeRouteValues(object? extra, int page)
    {
        var dict = new Dictionary<string, string> { ["page"] = page.ToString() };
        if (extra is null) return dict;

        foreach (var prop in extra.GetType().GetProperties())
        {
            var value = prop.GetValue(extra)?.ToString();
            if (value is not null) dict[prop.Name] = value;
        }
        return dict;
    }
}