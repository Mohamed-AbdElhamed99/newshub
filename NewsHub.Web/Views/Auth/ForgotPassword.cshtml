@using NewsHub.Web.Resources
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> Localizer
@model NewsHub.Web.Models.Auth.ForgotPasswordViewModel
@{
    ViewData["Title"] = Localizer["Forgot password"];
}

<div class="container-fluid py-5">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="bg-light rounded p-5">
                    <h1 class="mb-4">@Localizer["Reset your password"]</h1>
                    <p class="text-body mb-4">@Localizer["Enter the email on your account and we'll send you a link to reset your password."]</p>

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <form asp-controller="Auth" asp-action="ForgotPassword" method="post">
                        @Html.AntiForgeryToken()
                        <div class="row g-4">
                            <div class="col-12">
                                <input asp-for="Email" class="w-100 form-control border-0 py-3" placeholder="@Localizer["Email"]">
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                            <div class="col-12">
                                <button class="w-100 btn btn-primary form-control py-3" type="submit">@Localizer["Send reset link"]</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>