@using NewsHub.Web.Resources
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> Localizer
@model NewsHub.Web.Models.Auth.ResetPasswordViewModel
@{
    ViewData["Title"] = Localizer["Reset password"];
}

<div class="container-fluid py-5">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="bg-light rounded p-5">
                    <h1 class="mb-4">@Localizer["Choose a new password"]</h1>

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <form asp-controller="Auth" asp-action="ResetPassword" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Email" />
                        <input type="hidden" asp-for="Token" />
                        <div class="row g-4">
                            <div class="col-12">
                                <input asp-for="NewPassword" class="w-100 form-control border-0 py-3" placeholder="@Localizer["New Password"]">
                                <span asp-validation-for="NewPassword" class="text-danger"></span>
                            </div>
                            <div class="col-12">
                                <input asp-for="ConfirmPassword" class="w-100 form-control border-0 py-3" placeholder="@Localizer["Confirm New Password"]">
                                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                            </div>
                            <div class="col-12">
                                <button class="w-100 btn btn-primary form-control py-3" type="submit">@Localizer["Reset password"]</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>